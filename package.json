{
  "name": "pkg-placeholder",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.15.1",
  "description": "_description_",
  "author": "Hairy <wwu710632@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dsh-tauri-desk/pkg-placeholder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-tauri-desk/pkg-placeholder.git"
  },
  "bugs": "https://github.com/dsh-tauri-desk/pkg-placeholder/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.cjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "cordis.patch.yml",
    "dist",
    "src/main.css"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "taiwind": "src/main.css"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "prepack": "nr build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "prepare:skills": "skills-npm & pnpx skills experimental_install",
    "prepare:hooks": "git config core.hooksPath .githooks && simple-git-hooks",
    "prepare": "git rev-parse --git-dir && (pnpm run prepare:hooks && pnpm run prepare:skills) || exit 0"
  },
  "scripts-info": {
    "build": "Build the library for publishing",
    "dev": "Rebuild on change during development",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "start": "Run the entry file",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "prepare": "Set up git hooks and skills"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {
    "dsh-h3": "^0.2.2",
    "dsh-taiwind": "^0.3.3",
    "h3": "^2.0.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@antfu/ni": "^30.2.0",
    "@antfu/utils": "^9.3.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cosmokit": "1.9.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-commands": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-command-compact": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-fs": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-goal": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-permission-presets": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-stats": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-title": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-user-questions": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-util-code-language": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@genapi/core": "^4.1.4",
    "@genapi/pipeline": "^4.1.4",
    "@genapi/presets": "^4.1.4",
    "@types/node": "^26.1.1",
    "@vitest/browser-playwright": "^4.1.10",
    "bumpp": "^12.0.0",
    "eslint": "^10.7.0",
    "nano-staged": "^1.0.2",
    "playwright": "^1.62.1",
    "publint": "^0.3.21",
    "simple-git-hooks": "^2.13.1",
    "skills-npm": "^1.2.0",
    "tinyexec": "^1.3.1",
    "tsdown": "^0.22.12",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.12"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run build && npx nano-staged"
  },
  "nano-staged": {
    "*": "eslint --fix"
  }
}
