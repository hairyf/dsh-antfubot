{
  "name": "dsh-antfubot",
  "type": "module",
  "version": "0.2.4",
  "packageManager": "pnpm@11.15.1",
  "description": "Anthony Fu's agent workflow for DeepSeek Harness: issue triage, digest, task execution, PR creation and simplification",
  "author": "Hairy <wwu710632@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/hairyf/dsh-antfubot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairyf/dsh-antfubot.git"
  },
  "bugs": "https://github.com/hairyf/dsh-antfubot/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "antfu",
    "agent-skills",
    "triage",
    "pull-request"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.cjs"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "icon": "./assets/icon.svg",
  "files": [
    "README.md",
    "assets",
    "cordis.patch.yml",
    "dist",
    "docs",
    "locale",
    "src/main.css"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "taiwind": "src/main.css",
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "prepack": "nr build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "prepare:hooks": "git config core.hooksPath .githooks && simple-git-hooks",
    "prepare": "git rev-parse --git-dir && pnpm run prepare:hooks || exit 0"
  },
  "scripts-info": {
    "build": "Build the library for publishing",
    "dev": "Rebuild on change during development",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "start": "Run the entry file",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "prepare": "Set up git hooks and skills"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {
    "dsh-h3": "^0.2.2",
    "dsh-taiwind": "^0.3.3",
    "h3": "^2.0.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@antfu/ni": "^30.2.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser-playwright": "^4.1.10",
    "bumpp": "^12.0.0",
    "eslint": "^10.7.0",
    "nano-staged": "^1.0.2",
    "playwright": "^1.62.1",
    "publint": "^0.3.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-git-hooks": "^2.13.1",
    "tinyexec": "^1.3.1",
    "tsdown": "^0.22.12",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.12"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run build && npx nano-staged"
  },
  "nano-staged": {
    "*": "eslint --fix"
  }
}
